{
  "name": "editor-setup",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "node packages/registry-check/check-registry.mjs",
    "generate:submitters": "bun run scripts/resolve-pair-submitters.ts",
    "dev": "bun run --cwd apps/web dev",
    "build": "bun install --frozen-lockfile --cwd apps/web && bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "deploy": "bun run --cwd apps/web deploy",
    "typecheck": "bun run --cwd apps/web typecheck"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  }
}
